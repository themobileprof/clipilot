# Clio registry configuration
# Copy this file to .env and customize for your deployment

# Server Configuration
PORT=8080

# Public Base URL (for production deployments)
# Used in startup message and OAuth redirect URLs
# Production: https://clio.themobileprof.com
# Local: http://localhost:8082
BASE_URL=

# Data Storage
DATA_DIR=./data
# Production (systemd): DATA_DIR=/var/lib/clio-registry

# Static Assets (relative to binary location)
STATIC_DIR=./server/static
TEMPLATE_DIR=./server/templates
# Production (systemd):
# STATIC_DIR=/opt/clio-registry/server/static
# TEMPLATE_DIR=/opt/clio-registry/server/templates

# Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_in_production

# Optional: Database connection (future enhancement)
# DATABASE_URL=postgres://user:pass@localhost/clio_registry

# Registry URL for Clio clients
# Local: http://localhost:8082
# Production: https://clio.themobileprof.com
REGISTRY_URL=

# GitHub OAuth (for contributor authentication)
# Create OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://clio.themobileprof.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Security settings
# SESSION_SECRET=generate_a_random_secret_here
# SESSION_TIMEOUT=86400
# MAX_UPLOAD_SIZE=10485760

# Optional: Email notifications (future)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=email_password

# Optional: Telemetry and monitoring
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=info
